# Copy this file to .env (in the same directory) and set your game path.
# .env is git-ignored, so your local game installs never get committed.
#
# ADOFAI_GAME_PATH is the default used by every loader.
# A loader can override it with its own key to target a different install:
#
#   ADOFAI_GAME_PATH=...            default (all loaders, required for deploy+launch)
#   ADOFAI_GAME_PATH_UMM=...        UMM loader (-p:Loader=UMM)
#   ADOFAI_GAME_PATH_ML=...         MelonLoader (-p:Loader=ML)
#   ADOFAI_GAME_PATH_BEPINEX=...    BepInEx (-p:Loader=BepInEx)
#
# Windows example:
#   ADOFAI_GAME_PATH=C:\Games\ADOFAI\ADanceOfFireAndIce.exe
# Linux/macOS example:
#   ADOFAI_GAME_PATH=/path/to/A Dance of Fire and Ice/ADanceOfFireAndIce

ADOFAI_GAME_PATH=
