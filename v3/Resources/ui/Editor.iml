<Iris>
    <VBox gap="4">
        <Text text={localize('EditorShortcuts')} style="title" />
        <Separator />

        <HBox align="center">
            <Text text={localize('EnableEditorShortcuts')} style="label" />
            <Fill />
            <Switch value={settings.editorShortcuts.enableEditorShortcuts} on-changed="OnEnableEditorShortcutsToggled" />
            <Icon type="information" on-click="OnInfoToggle('EnableEditorShortcuts')" />
        </HBox>
        {isInfoExpanded('EnableEditorShortcuts') && <Text text={localize('EnableEditorShortcutsInfo')} style="hint" />}

        {settings.editorShortcuts.enableEditorShortcuts && <>
            <Separator />
            <Text text={localize('EditorShortcutsDecoration')} style="subtitle" />
            <Separator />

            <HBox align="center">
                <Text text={localize('ShortcutSelectAll')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.selectAllKey, settings.editorShortcuts.selectAllModifiers)} on-click="OnBindSelectAllKey" />
            </HBox>

            <HBox align="center">
                <Text text={localize('ShortcutDeselectAll')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.deselectAllKey, settings.editorShortcuts.deselectAllModifiers)} on-click="OnBindDeselectAllKey" />
            </HBox>

            <HBox align="center">
                <Text text={localize('ShortcutToggleVisibility')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.toggleVisibilityKey, settings.editorShortcuts.toggleVisibilityModifiers)} on-click="OnBindToggleVisibilityKey" />
            </HBox>

            <HBox align="center">
                <Text text={localize('ShortcutFocusDecoration')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.focusDecorationKey, settings.editorShortcuts.focusDecorationModifiers)} on-click="OnBindFocusDecorationKey" />
            </HBox>

            <Separator />
            <Text text={localize('EditorShortcutsNavigation')} style="subtitle" />
            <Separator />

            <HBox align="center">
                <Text text={localize('ShortcutGoToFloor')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.goToFloorKey, settings.editorShortcuts.goToFloorModifiers)} on-click="OnBindGoToFloorKey" />
            </HBox>

            <HBox align="center">
                <Text text={localize('ShortcutSelectAllFloors')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.selectAllFloorsKey, settings.editorShortcuts.selectAllFloorsModifiers)} on-click="OnBindSelectAllFloorsKey" />
            </HBox>

            <HBox align="center">
                <Text text={localize('CameraFollowOnFloorSelect')} style="label" />
                <Fill />
                <Checkbox value={settings.editorShortcuts.cameraFollowOnFloorSelect} on-changed="OnCameraFollowOnFloorSelectToggled" />
                <Icon type="information" on-click="OnInfoToggle('CameraFollowOnFloorSelect')" />
            </HBox>
            {isInfoExpanded('CameraFollowOnFloorSelect') && <Text text={localize('CameraFollowOnFloorSelectInfo')} style="hint" />}

            <Separator />
            <Text text={localize('EditorShortcutsPopup')} style="subtitle" />
            <Separator />

            <HBox align="center">
                <Text text={localize('ShortcutPopupSave')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.popupSaveKey, settings.editorShortcuts.popupSaveModifiers)} on-click="OnBindPopupSaveKey" />
            </HBox>

            <HBox align="center">
                <Text text={localize('ShortcutPopupDiscard')} style="label" />
                <Fill />
                <Button text={getShortcutDisplay(settings.editorShortcuts.popupDiscardKey, settings.editorShortcuts.popupDiscardModifiers)} on-click="OnBindPopupDiscardKey" />
            </HBox>
        </>}

        <Separator />
        <Text text={localize('EditorAutoplayShortcuts')} style="subtitle" />
        <Separator />

        <HBox align="center">
            <Text text={localize('EditorPauseAllowed')} style="label" />
            <Fill />
            <Switch value={settings.compatibility.editorPauseAllowed} on-changed="OnEditorPauseAllowedToggled" />
            <Icon type="information" on-click="OnInfoToggle('EditorPauseAllowed')" />
        </HBox>
        {isInfoExpanded('EditorPauseAllowed') && <Text text={localize('EditorPauseAllowedInfo')} style="hint" />}

        {settings.compatibility.editorPauseAllowed && <>
            <HBox align="center">
                <Text text={localize('EditorPauseEnabled')} style="label" />
                <Fill />
                <Checkbox value={settings.compatibility.editorPauseEnabled} on-changed="OnEditorPauseEnabledToggled" />
                <Icon type="information" on-click="OnInfoToggle('EditorPauseEnabled')" />
            </HBox>
            {isInfoExpanded('EditorPauseEnabled') && <Text text={localize('EditorPauseEnabledInfo')} style="hint" />}
            {settings.compatibility.editorPauseEnabled && <>
                <HBox align="center">
                    <Text text={localize('EditorPauseKey')} style="label" />
                    <Fill />
                    <Button text={getShortcutDisplay(settings.compatibility.editorPauseKey, settings.compatibility.editorPauseModifiers)} on-click="OnBindEditorPauseKey" />
                </HBox>
                <Text text={localize('EditorPauseKeyHint')} style="hint" />
            </>}
        </>}

        <Separator />
        <Text text={localize('EditorFloorOptimizations')} style="subtitle" />
        <Separator />

        <HBox align="center">
            <Text text={localize('EnableEditorFloorOptimization')} style="label" />
            <Fill />
            <Switch value={settings.optimizer.enableEditorFloorOptimization} on-changed="OnEditorFloorOptimizationToggled" />
            <Icon type="information" on-click="OnInfoToggle('EnableEditorFloorOptimization')" />
        </HBox>
        {isInfoExpanded('EnableEditorFloorOptimization') && <Text text={localize('EnableEditorFloorOptimizationInfo')} style="hint" />}

        {settings.optimizer.enableEditorFloorOptimization && <>
            <HBox align="center">
                <Text text={localize('IncrementalFloorInsert')} style="label" />
                <Fill />
                <Switch value={settings.optimizer.incrementalFloorInsert} on-changed="OnIncrementalFloorInsertToggled" />
                <Icon type="information" on-click="OnInfoToggle('IncrementalFloorInsert')" />
            </HBox>
            {isInfoExpanded('IncrementalFloorInsert') && <Text text={localize('IncrementalFloorInsertInfo')} style="hint" />}

            {settings.optimizer.incrementalFloorInsert && <>
                <HBox align="center">
                    <Text text={localize('RangeBasedRedraw')} style="label" />
                    <Fill />
                    <Checkbox value={settings.optimizer.rangeBasedRedraw} on-changed="OnRangeBasedRedrawToggled" />
                    <Icon type="information" on-click="OnInfoToggle('RangeBasedRedraw')" />
                </HBox>
                {isInfoExpanded('RangeBasedRedraw') && <Text text={localize('RangeBasedRedrawInfo')} style="hint" />}

                <HBox align="center">
                    <Text text={localize('SkipRedundantRemakePath')} style="label" />
                    <Fill />
                    <Checkbox value={settings.optimizer.skipRedundantRemakePath} on-changed="OnSkipRedundantRemakePathToggled" />
                    <Icon type="information" on-click="OnInfoToggle('SkipRedundantRemakePath')" />
                </HBox>
                {isInfoExpanded('SkipRedundantRemakePath') && <Text text={localize('SkipRedundantRemakePathInfo')} style="hint" />}

                <HBox align="center">
                    <Text text={localize('OptimizeOffsetFloorEvents')} style="label" />
                    <Fill />
                    <Checkbox value={settings.optimizer.optimizeOffsetFloorEvents} on-changed="OnOptimizeOffsetFloorEventsToggled" />
                    <Icon type="information" on-click="OnInfoToggle('OptimizeOffsetFloorEvents')" />
                </HBox>
                {isInfoExpanded('OptimizeOffsetFloorEvents') && <Text text={localize('OptimizeOffsetFloorEventsInfo')} style="hint" />}
            </>}
        </>}
    </VBox>
</Iris>
